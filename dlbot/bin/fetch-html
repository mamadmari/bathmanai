#!/usr/bin/env python3
"""واکشی HTML با شبیه‌سازی مرورگر (curl_cffi) برای سایت‌های پشت Cloudflare.
استفاده: fetch-html <url> [max_bytes]
"""
import sys

try:
    from curl_cffi import requests as creq
except Exception as exc:  # pragma: no cover
    sys.stderr.write(f"curl_cffi missing: {exc}\n")
    sys.exit(2)

url = sys.argv[1] if len(sys.argv) > 1 else ""
limit = int(sys.argv[2]) if len(sys.argv) > 2 else 3_000_000
if not url:
    sys.stderr.write("usage: fetch-html <url> [max_bytes]\n")
    sys.exit(2)

try:
    r = creq.get(url, impersonate="chrome", timeout=25, allow_redirects=True)
except Exception as exc:
    sys.stderr.write(f"fetch failed: {exc}\n")
    sys.exit(3)

sys.stderr.write(f"final={r.url} status={r.status_code}\n")
sys.stdout.write(r.text[:limit])
